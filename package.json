{
  "name": "@virag/adaptive-nav",
  "version": "0.1.0",
  "description": "Floating glass tab bar for mobile web apps: one pill, a Back circle that slides out on pushed screens, a screen-chosen action circle, and a buy mode where the pill becomes the call to action.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/adaptive-nav.css"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test src/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "motion": "^12.0.0 || ^13.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "keywords": [
    "react",
    "tab-bar",
    "bottom-navigation",
    "mobile",
    "motion",
    "glass"
  ]
}
